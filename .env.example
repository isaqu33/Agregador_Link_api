# Copy to .env for local Docker/dev
API_PORT_HOST=3070
AZURITE_BLOB_PORT_HOST=10070
MONGO_PORT_HOST=27070
CORS_ORIGINS=http://localhost:3071

# MongoDB
MONGO_USERNAME=agregador_user
MONGO_PASSWORD=agregador_pass_local
# Used outside Docker; compose builds its own URL pointing at the mongo container
DATABASE_URL=mongodb://agregador_user:agregador_pass_local@localhost:27070/agregador?authSource=admin

# Generate with: openssl rand -hex 32
SECRET_JWT=

# First user, created by `npm run seed`
SEED_USER_NAME=Admin
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me-1234

# Public URL of the front, used in the links of verification / reset e-mails
APP_URL=http://localhost:3071

# SMTP for those e-mails. Leave SMTP_HOST empty in dev: the message is printed in the API log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FaceLink <no-reply@example.com>

# Optional. With Redis, several API instances share the live analytics feed, the duplicate-visit guard
# and the rate limits. Without it everything is kept in memory (fine for a single instance).
# The dev compose already sets it for the redis container; use this line when running the API outside Docker.
REDIS_URL=
