# Copy to .env for local Docker/dev
API_PORT_HOST=3070
AZURITE_BLOB_PORT_HOST=10070
MONGO_PORT_HOST=27070
CORS_ORIGINS=http://localhost:3071

# MongoDB
MONGO_USERNAME=agregador_user
MONGO_PASSWORD=agregador_pass_local
# Used outside Docker; compose builds its own URL pointing at the mongo container
DATABASE_URL=mongodb://agregador_user:agregador_pass_local@localhost:27070/agregador?authSource=admin

# Generate with: openssl rand -hex 32
SECRET_JWT=
